# Copia este archivo a .env (cp .env.example .env) y llénalo. .env no se versiona.

# Usuario administrador de Jenkins.
JENKINS_ADMIN_USER=admin
# Genera una con: openssl rand -base64 24
JENKINS_ADMIN_PASSWORD=

# Token de GitHub de solo lectura (fine-grained: este repositorio, permiso "Contents: Read-only"
# y "Pull requests: Read-only"). Opcional pero recomendado: sin él, Jenkins consulta GitHub de
# forma anónima y llega rápido al límite de 60 peticiones por hora.
GITHUB_USER=
GITHUB_TOKEN=

# Repositorio que construye el Multibranch Pipeline.
NUTRIKIT_REPO_OWNER=MiguelLescasJorgeSebastian
NUTRIKIT_REPO_NAME=nutrikit

# Grupo dueño de /var/run/docker.sock. Docker Desktop (Mac, Windows): 0.
# Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
