# Solo para `npm run dev`. En producción el frontend se sirve desde {slug}.nutrikit.mx, junto a la
# API: no hay URL base ni cabecera X-Tenant (el consultorio sale del subdominio).
VITE_API_URL=http://localhost:8080
# Slug del consultorio local; se envía como X-Tenant (el backend solo lo acepta en el perfil dev).
VITE_TENANT=nutri-ana
